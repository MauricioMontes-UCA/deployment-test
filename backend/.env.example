# Server
PORT=3000
NODE_ENV=development
# Exact frontend origin. Required for credentialed CORS (cannot be "*").
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_login
DB_USER=postgres
DB_PASSWORD=postgres

# Sequelize connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Auth cookie
# lax: frontend and API on the same site (e.g. localhost:5173 -> localhost:3000)
# none: frontend and API on different domains (forces COOKIE_SECURE=true, HTTPS only)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
